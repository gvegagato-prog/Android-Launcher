    <application
        android:label="Carmesí"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Portico"
        android:allowBackup="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Carmesí como pantalla de inicio de Android: apagado hasta que lo activas en Estilo -->
        <activity-alias android:name=".InicioAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Sin pantalla: los accesos directos de cada juego pasan por aquí -->
        <activity android:name=".LanzarActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true" android:taskAffinity="" />
        <!-- Juegos de navegador a pantalla completa -->
        <activity android:name=".WebJuegoActivity" android:exported="false" android:theme="@style/PorticoWeb"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale|locale|layoutDirection|navigation|touchscreen|colorMode|mcc|mnc" />
        <!-- Widgets de la pantalla de inicio (los de Atrio, con juegos) -->
        <receiver android:name=".ActualizadorReceiver" android:exported="false" />
        <receiver android:name=".ActualizadorReabrir" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".WJugando" android:label="@string/w_jugando" android:exported="false">
